{
  "name": "multiclaude",
  "version": "0.1.0",
  "description": "Multi-tab Claude desktop wrapper with isolated account sessions per tab",
  "author": "rupesh kumar",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "node scripts/launch-desktop.mjs",
    "desktop:prod": "node scripts/launch-desktop.mjs --prod",
    "dist:win": "node scripts/generate-icon.mjs && npm run build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
